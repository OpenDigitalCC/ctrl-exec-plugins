#!/bin/bash
# check_mem - Nagios plugin: available memory as a percent of total.
#   check_mem [-w <pct>] [-c <pct>]
# WARNING / CRITICAL when MemAvailable is below that percent of MemTotal
# (defaults 10 and 5; -w must be at least -c). Reads /proc/meminfo; the
# variable CHECK_MEM_MEMINFO names another file, for testing only.
set -u
warn=10
crit=5
unknown() { echo "MEM UNKNOWN - $1"; exit 3; }
while getopts 'w:c:' opt; do
    case "$opt" in
        w) warn="$OPTARG" ;;
        c) crit="$OPTARG" ;;
        *) unknown "usage: check_mem [-w <pct>] [-c <pct>]" ;;
    esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || unknown "unexpected argument '$1'"
for v in "$warn" "$crit"; do
    [[ $v =~ ^[0-9]+$ ]] && [ "$v" -le 100 ] || unknown "thresholds must be whole percentages 0-100"
done
[ "$warn" -ge "$crit" ] || unknown "-w must not be below -c"

meminfo="${CHECK_MEM_MEMINFO:-/proc/meminfo}"
total_kb=$(awk '/^MemTotal:/ {print $2}' "$meminfo" 2> /dev/null)
avail_kb=$(awk '/^MemAvailable:/ {print $2}' "$meminfo" 2> /dev/null)
[[ ${total_kb:-} =~ ^[0-9]+$ ]] && [ "$total_kb" -gt 0 ] || unknown "no MemTotal in $meminfo"
[[ ${avail_kb:-} =~ ^[0-9]+$ ]] || unknown "no MemAvailable in $meminfo (kernel older than 3.14?)"

pct=$((avail_kb * 100 / total_kb))
avail_mb=$((avail_kb / 1024))
total_mb=$((total_kb / 1024))
state=OK
code=0
if [ "$pct" -lt "$crit" ]; then state=CRITICAL; code=2
elif [ "$pct" -lt "$warn" ]; then state=WARNING; code=1
fi
gib=$(awk -v a="$avail_kb" -v t="$total_kb" 'BEGIN {printf "%.1f GiB of %.1f GiB", a / 1048576, t / 1048576}')
echo "MEM $state - $pct% available ($gib) | available=${avail_mb}MB;$((total_mb * warn / 100));$((total_mb * crit / 100));0;$total_mb available_pct=$pct%;$warn;$crit;0;100"
exit "$code"
