#!/bin/bash
#
# htpasswd - ctrl-exec auth hook validating credentials against an Apache
# htpasswd file. The request username is the htpasswd user; the request token
# (ENVEXEC_TOKEN) is treated as the password. Supports any hash htpasswd(1) can
# verify (bcrypt, apr1/MD5, SHA, crypt).
#
# Configuration (environment):
#   HTPASSWD_FILE   path to the htpasswd file (default /etc/ctrl-exec/htpasswd)
#
# Manage entries with: htpasswd [-B] /etc/ctrl-exec/htpasswd <user>

set -u
trap 'exit 1' ERR            # any unexpected failure -> deny (fail closed)

USER_NAME="${ENVEXEC_USERNAME:-}"
PASS="${ENVEXEC_TOKEN:-}"
FILE="${HTPASSWD_FILE:-/etc/ctrl-exec/htpasswd}"

[ -n "$USER_NAME" ] || exit 2   # no username -> bad credentials
[ -n "$PASS" ]      || exit 2   # no password (token) -> bad credentials
[ -r "$FILE" ]      || exit 1   # file missing/unreadable -> deny (fail closed)

# htpasswd -vb verifies user+password against the file (exit 0 on match).
if htpasswd -vb "$FILE" "$USER_NAME" "$PASS" >/dev/null 2>&1; then
    exit 0
fi
exit 2                          # unknown user or wrong password
