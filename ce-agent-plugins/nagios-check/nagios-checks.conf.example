# nagios-checks.conf - a standard set of checks for a Debian host
#
# Install as /etc/nagios-checks/checks.conf (folder root:root 755), owned by
# root, mode 644 (the script runs as an unprivileged user and must be able to
# read it). Older installs used /etc/nagios-checks.conf; the script still reads
# that when the new path does not exist, and install.sh moves it. Needs the package
# monitoring-plugins-basic, plus check_mem from this plugin's plugins/ folder
# installed in /usr/local/lib/nagios/plugins (see README).
#
# Comments go on their own line only: a '#' after a value becomes part of the
# value. Each check runs for at most 'timeout' seconds, and one call to the
# script for at most 'budget' seconds; these six local checks take well under
# a second each.

# Seconds per check (default 10) and per run (default 50). Keep the budget
# below the dispatcher's read_timeout (default 60).
timeout = 10
budget  = 50

# Every real filesystem: WARNING under 15% free, CRITICAL under 5%. Without -p
# check_disk looks at all mounted filesystems; -X leaves out the types that
# are not storage. Add -X for other types that show up on your hosts.
disk    = check_disk -w 15% -c 5% -X tmpfs -X devtmpfs -X overlay -X squashfs -X nsfs -X efivarfs -X vfat

# Load average for 1, 5 and 15 minutes. -r divides by the number of CPUs, so
# the same thresholds suit a 2-core and a 64-core host.
load    = check_load -r -w 1.5,1.2,1 -c 3,2.5,2

# Memory still available (MemAvailable, so cache does not count as used):
# WARNING under 10% of total, CRITICAL under 5%. check_mem is not in
# monitoring-plugins; it is the plugin shipped beside this file.
mem     = check_mem -w 10 -c 5

# Swap free: WARNING under 30%, CRITICAL under 10%. A host with no swap at all
# reports UNKNOWN or CRITICAL depending on the plugin version; where your
# check_swap supports '-n ok' (no swap = OK) add it. The option name has not
# been checked against the installed version here: confirm with
# 'check_swap --help' before relying on it.
swap    = check_swap -w 30% -c 10%

# Zombie processes (state Z): WARNING at 5, CRITICAL at 20.
zombies = check_procs -s Z -w 5 -c 20

# Total number of processes: WARNING at 400, CRITICAL at 800.
procs   = check_procs -w 400 -c 800
