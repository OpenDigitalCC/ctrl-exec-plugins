      "purl": "pkg:deb/debian/bash"
    },
    {
      "type": "library",
      "name": "openssl",
      "version": "3",
      "description": "Throwaway-TLS listener/sender and certificate fingerprinting",
      "purl": "pkg:deb/debian/openssl"
    },
    {
      "type": "library",
      "name": "tar",
      "version": "1.35",
      "description": "Archive packing and verification",
      "purl": "pkg:deb/debian/tar"
    },
    {
      "type": "library",
      "name": "curl",
      "version": "8",
      "description": "HTTP client for the ctrl-exec API (coordinator scripts)",
      "purl": "pkg:deb/debian/curl"
    },
    {
      "type": "library",
      "name": "jq",
      "version": "1.7",
